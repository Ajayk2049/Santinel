# Handle line endings automatically for files detected as text 
# and truly force LF for all text files upon checkin.
* text=auto

# Core Source Files - Force LF everywhere (repo AND working directory)
*.java text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Scripts - Force specific line endings
*.sh text eol=lf
*.bat text eol=crlf

# Build Wrappers
mvnw text eol=lf
mvnw.cmd text eol=crlf

# Binary Files - Prevent any modification
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text
*.pdf binary
*.jar binary